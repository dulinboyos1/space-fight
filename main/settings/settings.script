local settings = require("main.settings.settings")

local settingsMetadata = json.decode(sys.load_resource("/config/settings-metadata.json"))

local sliderMaxSize = 375

local backgroundTint = vmath.vector4(0, 0, 0, 0.6)

local debounce = false
local debounceTimer = nil

local function broadcastChange()
	print("Begin broadcast")
	pprint(settings.subscribers)
	for urlKey, url in pairs(settings.subscribers) do
		print("Broadcasting to "..url)
		msg.post(url, "settingsChange")
	end
end

